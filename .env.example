# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio → https://aistudio.google.com/apikey (free). Optional: captions fall back to templates without it.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (falls back to gemini-2.5-flash)
GEMINI_MODEL=
